VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id
# GOOGLE_CLIENT_SECRET is a server-only Pages runtime secret; do not add it here.
VITE_GOOGLE_MAPS_API_KEY=your-restricted-browser-key
VITE_BASE_PATH=/
# Cloudflare Pages preview builds automatically force mock mode on.
VITE_DEV_MODE=false
# Override only when the Cloudflare production branch is not main.
CF_PAGES_PRODUCTION_BRANCH=main
VITE_LEMONSQUEEZY_PERSONAL_CHECKOUT_URL=
VITE_LEMONSQUEEZY_PRO_CHECKOUT_URL=
